# Use a unique random value with at least 32 characters in production.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Express server port.
PORT=3000

# Use "production" on the production server.
NODE_ENV="development"

# Primary browser origin and optional comma-separated additional origins.
APP_URL="http://localhost:3000"
CORS_ORIGINS=""

# Optional path to the persistent JSON database file.
# ASAKO_DB_FILE="C:\\path\\to\\persistent\\asako_db.json"

# Required only when creating a new production database file.
# ASAKO_ADMIN_EMAIL="admin@example.com"
# ASAKO_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"

# Demo accounts are blocked in production unless explicitly enabled.
# ASAKO_ALLOW_DEMO_ACCOUNTS="false"
